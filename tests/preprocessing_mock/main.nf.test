nextflow_pipeline {

    name "Test Workflow main.nf"
    script "./main.nf"

    test("Test preprocessing mock") {

        config "./nextflow.config"

        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            assert workflow.success
            assert snapshot(path("${outputDir}/samplesheets/").list().collectEntries { f ->
                if (!f.toString().endsWith('.yaml') && !f.toString().endsWith('.yml')) {
                    [f.toString().tokenize("/")[-1], f.list().collect { f2 -> Utils.create_yaml_snap(f2, outputDir) }]
                } else {
                    Utils.create_yaml_snap(f, outputDir)
                }
            }).match()
        }

    }

}
